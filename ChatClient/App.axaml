<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChatApp.Client.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <!-- macOS'un varsayılan yazı tipi (Helvetica) büyük Türkçe harflerin (İ, Ö, Ü, Ğ) üst
             işaretlerini kesiyor; Helvetica Neue'de bu sorun yok. Windows'ta Segoe UI kullanılır. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Helvetica Neue, Segoe UI, Arial" />
        </Style>
    </Application.Styles>
</Application>
