<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ChatApp.Client.Models"
        x:Class="ChatApp.Client.MainWindow"
        Title="YMH219 - Chat İstemcisi"
        Width="900" Height="580"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ListBox.compact ListBoxItem">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Üst çubuk: bağlantı bilgileri -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="10"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border x:Name="IndicatorBorder" DockPanel.Dock="Right"
                        CornerRadius="14" Padding="14,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IndicatorDot" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="IndicatorText" FontWeight="Bold" VerticalAlignment="Center"
                                   Padding="0,3,0,0" ClipToBounds="False" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Sunucu:" VerticalAlignment="Center" />
                    <TextBox x:Name="HostBox" Width="130" />
                    <TextBlock Text="Port:" VerticalAlignment="Center" />
                    <TextBox x:Name="PortBox" Width="70" />
                    <TextBlock Text="Kullanıcı adı:" VerticalAlignment="Center" />
                    <TextBox x:Name="UsernameBox" Width="120" Watermark="ör. ali" />
                    <Button x:Name="ConnectButton" Content="Bağlan" Click="ConnectButton_Click" />
                    <Button x:Name="DisconnectButton" Content="Bağlantıyı Kes" Click="DisconnectButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Alt durum çubuğu -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="10,5">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Mesaj yazma alanı -->
        <Border DockPanel.Dock="Bottom" Padding="10,0,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SendButton" Content="Gönder" Click="SendButton_Click" />
                    <Button x:Name="SaveHistoryButton" Content="Geçmişi Kaydet" Click="SaveHistoryButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                    <TextBlock Text="Alıcı:" VerticalAlignment="Center" />
                    <ComboBox x:Name="RecipientBox" Width="130" />
                </StackPanel>
                <TextBox x:Name="MessageInput" Watermark="Mesajınızı yazın ve Enter'a basın" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,190" Margin="10">
            <!-- Mesajlar -->
            <ListBox Grid.Column="0" x:Name="MessagesList" Classes="compact"
                     BorderBrush="#DDDDDD" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatLine">
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{Binding Foreground}"
                                   FontStyle="{Binding FontStyle}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Çevrimiçi kullanıcılar -->
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="UsersHeader" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Foreground="#666666"
                           Margin="0,6,0,0"
                           Text="Özel mesaj için bir kullanıcıya çift tıklayın veya Alıcı listesinden seçin." />
                <ListBox x:Name="UsersList" Classes="compact"
                         BorderBrush="#DDDDDD" BorderThickness="1"
                         DoubleTapped="UsersList_DoubleTapped" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
