<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ChatApp.Server.Models"
        x:Class="ChatApp.Server.MainWindow"
        Title="YMH219 - Chat Sunucusu"
        Width="900" Height="560"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ListBox.compact ListBoxItem">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Üst çubuk: port ve başlat/durdur -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="10"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border x:Name="IndicatorBorder" DockPanel.Dock="Right"
                        CornerRadius="14" Padding="14,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IndicatorDot" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="IndicatorText" FontWeight="Bold" VerticalAlignment="Center"
                                   Padding="0,3,0,0" ClipToBounds="False" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Port:" VerticalAlignment="Center" />
                    <TextBox x:Name="PortBox" Width="80" />
                    <Button x:Name="StartButton" Content="▶ Sunucuyu Başlat" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="■ Durdur" Click="StopButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Alt durum çubuğu -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="10,5">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="330,*" Margin="10">
            <!-- Bağlı istemciler -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock x:Name="ClientsHeader" DockPanel.Dock="Top" Classes="header" />
                <ListBox x:Name="ClientsList" Classes="compact"
                         BorderBrush="#DDDDDD" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ConnectedClient">
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Sunucu kayıtları -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Classes="header" Text="Sunucu kayıtları" />
                <ListBox x:Name="LogList" Classes="compact"
                         BorderBrush="#DDDDDD" BorderThickness="1"
                         FontFamily="Menlo, Consolas, Courier New, monospace" FontSize="12" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
